# Telegram bot token from @BotFather. Only needed for the local polling mode (bot.py).
# Never commit this file; .env is git-ignored. In AWS the token lives in SSM Parameter Store.
BOT_TOKEN=

# Optional: base URL of the Mini App page opened from the bot.
# HUB_BASE_URL=

# Optional scraping (OFF by default, see polite_http.py).
# SCRAPING_ENABLED=1
# JETPHOTOS_API_URL=
# SCHEDULE_PROVIDER=
